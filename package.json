{
  "name": "sulalah",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:start": "pnpm dlx supabase@2.120.0 start",
    "db:stop": "pnpm dlx supabase@2.120.0 stop",
    "db:reset": "pnpm dlx supabase@2.120.0 db reset",
    "db:test": "supabase/tests/run.sh",
    "db:types": "pnpm dlx supabase@2.120.0 gen types typescript --local > apps/web/lib/supabase/generated.ts",
    "seed:staging": "pnpm --filter @sulalah/web seed:staging"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
