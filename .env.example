# Copy to apps/web/.env.local. Real sign in and trees need both NEXT_PUBLIC_APP_ENV and the
# Supabase keys; without either the app runs as the in-browser demo.

# local | staging | production. Staging shows a "نسخة التجربة" badge.
NEXT_PUBLIC_APP_ENV=local

# Local Supabase (`pnpm db:start` prints these), or the staging project's keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, for the payment webhook later. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Payments: "sandbox" in development, "moyasar" in production
PAYMENT_PROVIDER=sandbox
MOYASAR_SECRET_KEY=
MOYASAR_WEBHOOK_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
