# Copy to apps/web/.env.local. Real sign in and trees need both NEXT_PUBLIC_APP_ENV and the
# Supabase keys; without either the app runs as the in-browser demo.

# local | staging | production. Staging shows a "نسخة التجربة" badge.
NEXT_PUBLIC_APP_ENV=local

# Local Supabase (`pnpm db:start` prints these), or the staging project's keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only, for payments, the billing job and the admin desk. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Payments (docs/BILLING.md). "sandbox" takes test cards and moves no money; it refuses to run
# on production. "moyasar" uses the keys below: sk_test_/pk_test_ on staging, live on production.
PAYMENT_PROVIDER=sandbox
MOYASAR_SECRET_KEY=
NEXT_PUBLIC_MOYASAR_PUBLISHABLE_KEY=
# The secret typed on Moyasar's dashboard for the webhook https://<domain>/api/webhooks/payments
MOYASAR_WEBHOOK_SECRET=
# Vercel sends it to /api/cron/billing as "Authorization: Bearer <secret>".
CRON_SECRET=

# WhatsApp, the one channel for login codes and every notice (docs/WHATSAPP.md). Without the
# token and number id, messages go to the server log outside production and wait on production.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# For submitting the templates (pnpm --filter @sulalah/web whatsapp:templates --submit).
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Meta's webhook https://<domain>/api/webhooks/whatsapp: the app secret signs it, the verify
# token is typed on Meta's page when subscribing.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Optional: mock | off to force a mode; template renames as key=name,key=name.
WHATSAPP_MODE=
WHATSAPP_TEMPLATE_NAMES=

# Login codes (Supabase Auth > Hooks > Send SMS > https://<domain>/api/auth/sms-hook): WhatsApp
# first, SMS through Unifonic only when WhatsApp did not arrive.
SEND_SMS_HOOK_SECRET=
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=

NEXT_PUBLIC_APP_URL=http://localhost:3000
